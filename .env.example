# Phase 1 uses public company defaults when these values are absent.
NEXT_PUBLIC_SITE_URL=https://aimdigitallimited.co.uk
# Optional external booking tool (e.g. Calendly). Defaults to the /contact page.
NEXT_PUBLIC_BOOKING_URL=
# Quote form: configure a Resend API key and a sender on your verified domain.
# Quote requests always go to support@aimdigitallimited.co.uk.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Phase 4: analytics will only load after consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
# Blog and admin database (Prisma Postgres). Pooled URL for the app; direct URL for migrations.
DATABASE_URL=
DIRECT_DATABASE_URL=
